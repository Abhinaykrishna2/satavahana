# Satavahana — Zerodha Market Data Pipeline Configuration
# Copy this file to config/config.toml and fill in your credentials.

[kite]
# From your Kite Connect app at https://developers.kite.trade
api_key    = "your_api_key_here"
api_secret = "your_api_secret_here"

# Leave access_token EMPTY (or remove the line) to trigger the automated
# OAuth login flow on startup — browser opens, you log in, token is captured
# automatically and cached in config/.kite_token for the rest of the trading day.
#
# Only fill this manually if you want to bypass the login flow.
access_token = ""

[equities]
# Symbols to watch on both NSE and BSE for spread arbitrage
symbols = ["INFY", "TCS", "RELIANCE", "HDFCBANK", "ICICIBANK", "SBIN", "ITC", "LT", "WIPRO", "TATASTEEL"]

[options]
# Underlying indices for options chain.
# Supported: NIFTY, NIFTYNXT50, FINNIFTY (and any single-stock NFO name).
# MIDCPNIFTY omitted: options are illiquid with wide bid-ask spreads.
underlyings = ["NIFTY"]
# Leave empty for AUTO mode (nearest available expiry selected per underlying).
# Optional manual override: set to a specific YYYY-MM-DD.
expiry = ""
# Strike range [min, max] — must cover ALL configured underlyings.
# FINNIFTY ~24000, NIFTY ~25000, NIFTYNXT50 ~27000.
# Set min=0 / max=999999 to include all available strikes (recommended).
strike_min = 0.0
strike_max = 999999.0
# Strike step size (used only for display/logging; filtering is by strike_min/max)
strike_step = 50.0
# Global default: keep the ATM strike plus the N nearest strikes on EACH side.
# Both CE and PE are retained for every kept strike.
# 15 each side = up to 62 contracts per underlying (31 strikes × 2 option sides).
# Applies to NIFTY and NIFTYNXT50 (most liquid — use more strikes for chain-level OI coverage).
# Total tokens with the defaults below: NIFTY(62) + NIFTYNXT50(62) + FINNIFTY(22) + 3 index = 149.
nearest_strikes = 15
# Per-underlying override: FINNIFTY data quality is lower (illiquid OTM strikes, zero-LTP rows).
# Restrict to 5 each side to keep only the liquid near-ATM zone.
[options.nearest_strikes_override]
FINNIFTY = 5

[greeks]
# Risk-free rate (annualized, decimal). 6.5% for Indian markets
risk_free_rate = 0.065
# Dividend yield (annualized, decimal). Set to 0 if unknown
dividend_yield = 0.0

[output]
# Minimum spread in rupees to log (noise filter)
min_spread_alert = 0.50
# Log frequency for options greeks (every N ticks)
greeks_log_interval = 1
# Record EVERY raw tick to data/*_ticks.csv. OFF by default — this is the
# firehose (~25 GB in 2 days). When enabled, the recorder also writes
# data/YYYY-MM-DD_option_selling_ticks.csv for passive short-premium research
# on the locked option strikes. Only signal/trade ledgers are written otherwise.
# Set true ONLY for offline data collection, never for lean live trading.
record_ticks = false

# ─── NSE Options Signal Engine ───────────────────────────────────────────────
# Capital path: ₹5,000 → ₹50,000 via 6 quant strategies
# All fields have safe defaults — this block is OPTIONAL in config/config.toml
[options_engine]
# Your starting trading capital in INR
initial_capital = 10000.0

# Daily circuit-breaker: halt all new positions if loss exceeds this % today
# 30% = stop trading once day's loss > ₹1,500 on ₹5,000 capital
max_daily_loss_pct = 30.0

# Profit target on option premium (% gain from entry price)
# 55% = if you bought at ₹100, exit when option reaches ₹155
profit_target_pct = 55.0

# Stop-loss on option premium (% loss from entry price)
# 35% = if you bought at ₹100, exit when option falls to ₹65
stop_loss_pct = 35.0

# Minimum composite confidence score (0-100) to act on a signal.
# Each strategy scores sub-signals; composite must clear this bar.
# 58 = balanced. Raise to 65+ for fewer, higher-quality signals.
min_confidence = 58.0

# Optional expiry-day carve-out for pure gamma scalp setups.
# Keeps the regular floor at 58 while allowing same-day expiry gamma trades
# to trigger from 51+ when that exact strategy is the dominant signal.
expiry_day_min_confidence = 51.0

# How often to run the full chain scan (seconds)
# 45 = scan every 45s during market hours
scan_interval_secs = 45

# Max total entries per IST trading day (across all underlyings)
# 1 = take the first qualifying signal of the day and stop. If it stops out,
# no further entries — avoids compounding losses on volatile days.
max_daily_trades = 1

[execution]
# Set true only when you want live broker order placement enabled.
enable_live_orders = false

# Kite order parameters for options execution.
variety = "regular"
exchange = "NFO"
product = "MIS"
order_type = "MARKET"
validity = "DAY"

# Prefix used in Kite order tag for place/cancel/status correlation.
order_tag_prefix = "SATA"

# Cancel unfilled limit entry orders after this many seconds (default: 240 = 4 minutes).
entry_order_timeout_secs = 240

# Cancel pending entry if the option LTP drops this fraction below the limit price.
# A large drop means the market reversed direction — no point filling a stale signal.
# Default 0.15 = cancel if LTP < limit_price × 0.85 (15% adverse move).
limit_cancel_reversal_pct = 0.15

# ──────────────────────────────────────────────────────────────────────────
# LIVE MICROSTRUCTURE ENGINE (NEW — Strategy 1 + Strategy 2)
# ──────────────────────────────────────────────────────────────────────────
# Runs ONLY when started with --live / --micro, or when enabled = true here.
# Without these flags the engine runs the existing options/quant collector path
# unchanged — all previous strategies remain intact.

[microstructure]
# Master switch. Also turned on by the --live / --micro CLI flags.
enabled = false

# Strategy 1 — Micro-Price Transient Imbalance (equity MIS).
# Disabled for current options-only operation.
equity_imbalance_enabled = false
# NSE cash symbols to watch if equity trading is deliberately re-enabled later.
equity_watchlist = []
# Raw top-5 OBI (in [-1,1]) at/below which a sell wall is "extreme". -0.4 = asks
# ~2.3x bids. (Field name kept as obi_z_threshold for back-compat.)
obi_z_threshold = -0.4
# Rolling window (snapshots) used to standardize OBI / baseline OFI.
obi_lookback = 60
# Require OFI to turn positive (buyers absorbing) before entering long.
ofi_confirm = true

# Strategy 2 — Tuesday Nifty ATM gamma squeeze (options).
gamma_squeeze_enabled = true
# ATM ask-queue depletion must exceed this multiple of its rolling average.
gamma_depletion_multiple = 5.0
gamma_ma_window = 30
nifty_symbol = "NIFTY"

# Sizing / pacing.
mis_leverage = 5.0
max_concurrent_positions = 1
signal_cooldown_secs = 30

[risk]
# Hard per-trade stop as % of the (hourly-polled) capital.
per_trade_stop_pct = 1.0
# LOWER circuit: halt ALL new trades once the day's realized P&L (NET of broker
# fees + transaction costs) draws down this % of day-start capital.
daily_loss_circuit_pct = 15.0
# UPPER circuit: halt ALL new trades once the day's realized P&L gains this % of
# day-start capital — prevents overtrading a good day.
daily_profit_circuit_pct = 25.0
# (Legacy key `daily_kill_pct` is still accepted as an alias for the lower circuit.)
# IST time to cancel pending orders and square off (before Zerodha auto-square).
flatten_time = "15:15"
# Hourly capital sync schedule (IST). First poll at start, then :minute hourly.
capital_sync_start = "09:14"
capital_poll_minute = 14

# Extra [execution] keys used by the limit-chase OMS (all optional, shown with
# defaults): equity_exchange = "NSE", equity_product = "MIS",
# max_repegs = 5, repeg_tick_threshold = 1, chase_timeout_ms = 3000,
# min_repeg_interval_ms = 250  (250ms => <=4 modifies/sec, under the 10/sec cap)
